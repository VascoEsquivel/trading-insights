# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Finnhub — free key at https://finnhub.io  (stock quotes + company news)
FINNHUB_API_KEY=

# CoinGecko — free Demo key from the CoinGecko developer dashboard
# (crypto prices + OHLC). Keyless access is throttled hard; use a key.
COINGECKO_API_KEY=

# Reddit sentiment layer. Leave ENABLE_REDDIT=false until a "script" app at
# reddit.com/prefs/apps is approved — everything else runs without it.
ENABLE_REDDIT=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trading-insights/0.1 by u/your_username

# DexScreener and yfinance need no credentials.
